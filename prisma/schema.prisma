generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id              String        @id @default(cuid())
  slug            String        @unique // e.g., "cafe-atlas"
  name            String        // e.g., "Café Atlas"
  niche           String        @default("cafe") // cafe, barber, snack, wash, beauty, laundry, other
  city            String        @default("الدار البيضاء")
  phone           String?
  pinCode         String        @default("1234") // PIN for merchant dashboard login
  logoIcon        String        @default("coffee")
  primaryColor    String        @default("#5b3519")
  bgGradient      String        @default("linear-gradient(150deg,#6b4226 0%,#3d2414 100%)") @db.Text
  stampsRequired  Int           @default(5)
  rewardName      String        @default("قهوة مجانية")
  customerPrefix  String        @default("عزيزي")
  loyaltyMode     String        @default("BOTH") // "STAMPS", "CASHBACK", or "BOTH"
  cashbackRate    Float         @default(10)     // e.g., 10 means 10% cashback
  welcomeCashback Float         @default(5)      // e.g., 5 MAD welcome bonus on signup (0 if disabled)
  minCashbackRedeem Float       @default(0)      // Minimum balance required to redeem cashback
  currency        String        @default("DH")   // "DH", "MAD", "€"
  latitude        Float?        @default(33.5731)
  longitude       Float?        @default(-7.5898)
  radarMessage    String        @default("أنت بالقرب منا! تفضل بزيارتنا وبطاقتك جاهزة.")
  googleMapsUrl   String?
  staffMembers       String        @default("[{\"name\":\"أمين (كاشير)\",\"pin\":\"1111\"}]") @db.Text // JSON array of { name, pin }
  cooldownMinutes    Int           @default(30)     // Anti-fraud minimum minutes between scans for the same customer
  vipVisitsThreshold Int           @default(10)     // Visits needed to unlock VIP Gold Card
  vipCashbackBonus   Float         @default(5)      // Extra % cashback for VIPs (e.g., 10% + 5% = 15%)
  referralBonus      Float         @default(10)     // Cashback DH bonus for referring a friend (or 1 free stamp)
  radarZones         String        @default("[]") @db.Text   // JSON array of up to 10 { name, lat, lng, message } zones
  promoTemplates     String        @default("[]") @db.Text   // JSON array of custom promo templates { id, label, text }
  branches           String        @default("[]") @db.Text   // JSON array of branch locations { id, name, city, latitude, longitude, googleMapsUrl, radarMessage, isMain }
  menuUrl            String?       @default("https://instagram.com")
  instagramUrl       String?       @default("https://instagram.com")
  termsText          String        @default("البطاقة صالحة في جميع فروع المتجر. لا يمكن استبدال المكافآت نقداً.") @db.Text
  plan            String        @default("GROWTH") // STARTER, GROWTH, MULTI
  credits         Int           @default(1000)
  autoWinback     Boolean       @default(true)
  autoReview      Boolean       @default(true)
  autoRadar       Boolean       @default(true)
  autoNearReward  Boolean       @default(false)
  isActive        Boolean       @default(true)
  careExpiresAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customers       Customer[]
  transactions    Transaction[]
  campaigns       Campaign[]
  notifications   Notification[]
}

model Customer {
  id                String        @id @default(cuid())
  merchantId        String
  merchant          Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  passSerial        String        @unique @default(cuid())
  memberCode        String        // 4-digit display ID e.g. "4821"
  stamps            Int           @default(0)
  loyaltyType       String        @default("STAMPS") // STAMPS or CASHBACK
  cashbackBalance   Float         @default(0)        // Current spendable cashback balance
  totalCashbackEarned Float       @default(0)        // Lifetime cashback earned
  totalSpent        Float         @default(0)        // Lifetime bill amount spent at merchant
  totalVisits       Int           @default(1)
  rewardsRedeemed   Int           @default(0)
  isVip              Boolean       @default(false)
  referredByCode     String?       // 4-digit memberCode of the customer who referred them
  referralsCount     Int           @default(0)      // How many friends this customer brought in
  lastVisitAt       DateTime      @default(now())
  walletType        String        @default("WEBPASS") // APPLE, GOOGLE, WEBPASS
  pushSubscription  String?       @db.Text        // JSON string for Web Push API
  applePushToken    String?       @db.Text        // APNs token for Apple Wallet
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions      Transaction[]
  notifications     Notification[]

  @@index([merchantId])
  @@unique([merchantId, phone])
}

model Transaction {
  id            String    @id @default(cuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String    // STAMP_ADDED, REWARD_REDEEMED, CARD_CREATED, CASHBACK_EARNED, CASHBACK_REDEEMED
  stampsDelta   Int       @default(1)
  billAmount    Float?    // Original purchase bill amount (for CASHBACK_EARNED)
  cashbackDelta Float?    // +amount earned or -amount redeemed
  note          String?   @db.Text
  staffName     String    @default("المدير") // Tracks which staff member performed the scan
  branchName    String?   // Tracks which branch processed this transaction
  createdAt     DateTime  @default(now())

  @@index([merchantId, createdAt])
}

model Campaign {
  id            String    @id @default(cuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title         String
  message       String    @db.Text
  audience      String    @default("ALL") // ALL, QUIET, NEAR_REWARD, VIP
  sentCount     Int       @default(0)
  returnedCount Int       @default(0)
  creditsUsed   Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([merchantId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId  String?   // null means broadcast to all merchant customers
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String    // STAMP, REWARD, PROMO, WINBACK, BIRTHDAY, RADAR, NEAR_REWARD, REVIEW
  title       String
  body        String    @db.Text
  actionUrl   String?   // e.g., Google Maps review URL
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([merchantId, createdAt])
}

model Lead {
  id          String    @id @default(cuid())
  shopName    String
  niche       String    @default("cafe")
  city        String
  phone       String?
  plan        String    @default("growth") // starter, growth, multi
  price       String    @default("2,400")
  usedDemo    Boolean   @default(false)
  status      String    @default("NEW") // NEW, CONTACTED, CONVERTED
  createdAt   DateTime  @default(now())
}
